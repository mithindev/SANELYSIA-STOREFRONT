# SAN ELYSIA — Environment Configuration Example

# Headless Commerce Engine Base API URL
# Default local Optiviz retail engine port is 5098 or 5000
NEXT_PUBLIC_STOREFRONT_API_URL=http://localhost:5098

# Tenant Publishable Key (Read-scoped, safe for client-side inclusion)
# Format: pk_live_... or pk_test_...
NEXT_PUBLIC_STOREFRONT_KEY=pk_test_sanelysia_storefront_live

# Default Storefront Tenant Slug / ID (Optional)
NEXT_PUBLIC_TENANT_ID=sanelysia

# Server-only API secrets (Never exposed to browser)
# STOREFRONT_INTERNAL_API_SECRET=
